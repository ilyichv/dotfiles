### check-i18n
alias check-i18n="rg -n --ignore-file=.gitignore -g '*.{js,jsx,ts,tsx}' --color=always '>\s*[A-Za-z0-9][^<>{}]*\s*<' | grep -v -E '=>|<=|>=|interface|extends|Promise|ComponentProps|\w+:\s*\(|\(\w+:\s*\w+.*\)|\w+<\w+>'"  
