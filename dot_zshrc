# Add deno completions to search path
if [[ ":$FPATH:" != *":/Users/ilyichv/completions:"* ]]; then export FPATH="/Users/ilyichv/completions:$FPATH"; fi

export ASDF_DATA_DIR=/Users/ilyichv/.asdf
export PATH="$ASDF_DATA_DIR/shims:$PATH"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/ilyichv/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/ilyichv/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/ilyichv/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/ilyichv/google-cloud-sdk/completion.zsh.inc'; fi
# bun completions
[ -s "/Users/ilyichv/.bun/_bun" ] && source "/Users/ilyichv/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# pnpm
export PNPM_HOME="/Users/ilyichv/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# opencode
export PATH=/Users/ilyichv/.opencode/bin:$PATH

# claude
export PATH="$HOME/.local/bin:$PATH"

# zsh-autosuggestions
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
bindkey "^[[A" history-beginning-search-backward
bindkey "^[[B" history-beginning-search-forward

# zsh-syntax-highlighting
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# aliases
[[ -f ~/.aliases ]] && source ~/.aliases

# zoxide
eval "$(zoxide init zsh --cmd cd)"

# fzf
source <(fzf --zsh)

# starship
eval "$(starship init zsh)"
